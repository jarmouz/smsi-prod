# Clé secrète Flask (obligatoire en production) — générez une valeur aléatoire
SECRET_KEY=changez-moi-en-production
# --- Sécurité ---
# Cookies de session en HTTPS uniquement : 1 en production, 0 en dev HTTP local
SESSION_COOKIE_SECURE=1
# Anti-force-brute au login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15


# Base de données (déjà fournie par docker-compose)
DATABASE_URL=postgresql://smsi:smsi@db:5432/smsi

# Répertoire des pièces jointes (monté sur un volume Docker persistant)
UPLOAD_DIR=/data/uploads
# Taille maximale d'un fichier téléversé (Mo)
MAX_UPLOAD_MB=15

# Stockage des pièces jointes : "local" (défaut) ou "webdav" (Nextcloud)
STORAGE_BACKEND=local
# Si STORAGE_BACKEND=webdav, renseignez le compte de service Nextcloud :
NEXTCLOUD_URL=https://docs.kaizen-intelligence.tn
NEXTCLOUD_USER=smsi-svc
NEXTCLOUD_PASSWORD=mot-de-passe-application-nextcloud
NEXTCLOUD_FOLDER=SMSI
# Dossier de l'espace « Docs » navigable dans l'app
NEXTCLOUD_DOCS_FOLDER=Documents

# --- OnlyOffice (édition en ligne des fichiers du module Docs) ---
# Laisser vide pour désactiver. Nécessite STORAGE_BACKEND=webdav.
ONLYOFFICE_URL=https://office.kaizen-intelligence.tn
ONLYOFFICE_JWT_SECRET=un-secret-partage-fort
# URL publique du SMSI, joignable par le Document Server (défaut : APP_BASE_URL)
ONLYOFFICE_CALLBACK_BASE=https://smsi.kaizen-intelligence.tn
