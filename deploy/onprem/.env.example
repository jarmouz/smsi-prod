# =====================================================================
#  SMSI - configuration de l'installation sur site
#  install.sh crée .env à partir de ce modèle et génère les secrets.
# =====================================================================

# Version des images livrées (ne pas modifier à la main : update.sh s'en charge)
SMSI_VERSION=

# Nom d'accès à l'application (DNS interne du client), sans https://
SMSI_DOMAIN=smsi.entreprise.local
APP_BASE_URL=https://smsi.entreprise.local
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets : générés par install.sh, UNIQUES pour chaque installation ---
SECRET_KEY=
POSTGRES_PASSWORD=

# --- Sécurité ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Performances ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
MAX_UPLOAD_MB=15
APP_TIMEZONE=Africa/Tunis

# --- Stockage des pièces jointes : local (volume Docker) ou webdav (Nextcloud) ---
STORAGE_BACKEND=local
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
# Pièces jointes : <dossier>/<organisation> ; espace documentaire de la 1re organisation,
# puis <SMSI-Organisations>/<organisation> pour les suivantes
NEXTCLOUD_ATTACHMENTS_FOLDER=SMSI-PJ
NEXTCLOUD_DOCS_FOLDER=SMSI/Documents
NEXTCLOUD_ORGS_FOLDER=SMSI-Organisations
# Certificat de l'autorité interne si Nextcloud utilise la PKI du client :
# déposer le fichier PEM dans ca/ puis décommenter (voir README) :
# REQUESTS_CA_BUNDLE=/ca/ca-entreprise.pem

# --- OnlyOffice (facultatif, nécessite STORAGE_BACKEND=webdav) ---
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_CALLBACK_BASE=

# --- Rappels par e-mail : domaines jamais notifiés ---
NOTIFY_SKIP_DOMAINS=.demo,.local,.test,.example,example.com

# --- Sauvegardes ---
BACKUP_KEEP_DAYS=30
